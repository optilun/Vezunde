{
  "name": "Request",
  "type": "object",
  "properties": {
    "need_category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "service_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "city": {
      "type": "string"
    },
    "for_whom": {
      "type": "string",
      "enum": [
        "adult",
        "copil"
      ]
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normala",
        "urgenta"
      ]
    },
    "timing": {
      "type": "string"
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_preference": {
      "type": "string"
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_location_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "noua",
        "procesata"
      ],
      "default": "noua"
    }
  },
  "required": [
    "need_category",
    "city",
    "contact_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}