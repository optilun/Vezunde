{
  "name": "ProviderClaimRequest",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "claim",
        "new_location",
        "new_location_duplicate_review"
      ]
    },
    "claim_subject_type": {
      "type": "string",
      "enum": [
        "organization",
        "independent_professional"
      ]
    },
    "claimant_relationship": {
      "type": "string",
      "enum": [
        "owner",
        "organization_representative",
        "location_manager",
        "authorized_staff"
      ]
    },
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "representation_confirmed": {
      "type": "boolean",
      "default": false
    },
    "submitted_payload": {
      "type": "string"
    },
    "identity_check_snapshot": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "in_asteptare",
        "needs_more_info",
        "aprobata",
        "respinsa"
      ],
      "default": "in_asteptare"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "contact_name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}