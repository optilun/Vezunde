{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}