{
  "name": "UserFeedback",
  "type": "object",
  "properties": {
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "message": {
      "type": "string",
      "maxLength": 1200
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "account_mode": {
      "type": "string",
      "enum": ["personal", "provider", "professional", "applicant"]
    },
    "organization_id": {
      "type": "string"
    },
    "professional_profile_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "page_path": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["new", "reviewed", "archived"],
      "default": "new"
    }
  },
  "required": ["rating", "user_id", "account_mode", "status"],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "user" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
