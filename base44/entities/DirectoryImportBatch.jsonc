{
  "name": "DirectoryImportBatch",
  "type": "object",
  "properties": {
    "batch_key": { "type": "string" },
    "snapshot_id": { "type": "string" },
    "contract_version": { "type": "string" },
    "source_version": { "type": "string" },
    "source_sha256": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": ["dry_run", "import"],
      "default": "dry_run"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planning",
        "ready",
        "approved",
        "running",
        "completed",
        "completed_with_errors",
        "failed",
        "rolling_back",
        "rolled_back",
        "rollback_failed"
      ],
      "default": "draft"
    },
    "execution_cursor": { "type": "number", "default": 0 },
    "rollback_cursor": { "type": "number", "default": 0 },
    "execution_lock_token": { "type": "string" },
    "execution_lock_expires_at": { "type": "string", "format": "date-time" },
    "approval_token_hash": { "type": "string" },
    "approved_by_user_id": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "total_rows": { "type": "number", "default": 0 },
    "valid_rows": { "type": "number", "default": 0 },
    "blocked_rows": { "type": "number", "default": 0 },
    "ready_rows": { "type": "number", "default": 0 },
    "applied_rows": { "type": "number", "default": 0 },
    "failed_rows": { "type": "number", "default": 0 },
    "skipped_rows": { "type": "number", "default": 0 },
    "created_organizations": { "type": "number", "default": 0 },
    "created_locations": { "type": "number", "default": 0 },
    "updated_locations": { "type": "number", "default": 0 },
    "created_links": { "type": "number", "default": 0 },
    "summary_json": { "type": "string" },
    "created_by_user_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "rollback_started_at": { "type": "string", "format": "date-time" },
    "rollback_finished_at": { "type": "string", "format": "date-time" },
    "rollback_of_batch_id": { "type": "string" },
    "failure_message": { "type": "string" }
  },
  "required": [
    "batch_key",
    "snapshot_id",
    "contract_version",
    "source_version",
    "source_sha256",
    "mode",
    "status"
  ],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "admin" } }
  }
}
