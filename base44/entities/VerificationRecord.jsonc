{
  "name": "VerificationRecord",
  "type": "object",
  "properties": {
    "location_id": {
      "type": "string"
    },
    "claim_request_id": {
      "type": "string"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "manual",
        "email",
        "phone",
        "document"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "phone",
        "email",
        "document"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "aprobat",
        "respins",
        "suspendat"
      ]
    },
    "notes": {
      "type": "string"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "location_id",
    "result"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}