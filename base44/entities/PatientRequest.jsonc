{
  "name": "PatientRequest",
  "type": "object",
  "properties": {
    "contract_version": { "type": "string" },
    "questionnaire_version": { "type": "string" },
    "questionnaire_key": { "type": "string" },
    "intent": { "type": "string" },
    "original_message": { "type": "string" },
    "detailed_message": { "type": "string" },
    "service_keys": {
      "type": "array",
      "items": { "type": "string" }
    },
    "location_scope": {
      "type": "string",
      "enum": ["locality", "county", "geo", "city", "national"],
      "default": "locality"
    },
    "city": { "type": "string" },
    "county": { "type": "string" },
    "locality_siruta_code": { "type": "string" },
    "client_address_text": { "type": "string" },
    "for_whom": {
      "type": "string",
      "enum": ["adult", "copil", "other_adult"]
    },
    "age_group": { "type": "string" },
    "urgency": {
      "type": "string",
      "enum": ["normala", "urgenta"],
      "default": "normala"
    },
    "timing_key": { "type": "string" },
    "preferences": {
      "type": "array",
      "items": { "type": "string" }
    },
    "selected_location_id": { "type": "string" },
    "request_source": {
      "type": "string",
      "enum": ["patient_search", "admin", "legacy"],
      "default": "patient_search"
    },
    "requester_user_id": { "type": "string" },
    "contact_record_id": { "type": "string" },
    "contact_email_hash": { "type": "string" },
    "contact_identity_hash": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "public_reference": { "type": "string" },
    "interpretation_version": { "type": "string" },
    "interpretation_confidence_band": { "type": "string" },
    "interpretation_agreement_status": { "type": "string" },
    "possible_safety_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendation_contract_version": { "type": "string" },
    "matching_coverage_status": { "type": "string" },
    "matching_need_level": { "type": "string" },
    "match_count": { "type": "number", "default": 0 },
    "top3_count": { "type": "number", "default": 0 },
    "distribution_lock_token": { "type": "string" },
    "distribution_lock_at": { "type": "string", "format": "date-time" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "no_response_review_contract_version": { "type": "string" },
    "no_response_review_action": {
      "type": "string",
      "enum": ["keep_waiting"]
    },
    "no_response_reviewed_at": { "type": "string", "format": "date-time" },
    "no_response_next_review_at": { "type": "string", "format": "date-time" },
    "no_response_review_count": { "type": "number", "default": 0 },
    "lifecycle_contract_version": { "type": "string" },
    "lifecycle_state": {
      "type": "string",
      "enum": ["active", "resolved", "closed", "expired"],
      "default": "active"
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": ["submitted", "distributed", "waiting_responses", "has_responses", "conversation_active", "resolved", "closed", "expired"],
      "default": "submitted"
    },
    "lifecycle_updated_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" },
    "closed_by": {
      "type": "string",
      "enum": ["patient", "system", "admin"]
    },
    "expiration_processed_at": { "type": "string", "format": "date-time" },
    "lifecycle_lock_token": { "type": "string" },
    "lifecycle_lock_at": { "type": "string", "format": "date-time" },
    "persistence_state": {
      "type": "string",
      "enum": ["creating", "complete", "partial_failure"],
      "default": "creating"
    },
    "status": {
      "type": "string",
      "enum": ["noua", "salvata", "pregatita_pentru_distribuire", "procesata", "retrasa", "inchisa", "expirata"],
      "default": "salvata"
    }
  },
  "required": [
    "contract_version",
    "questionnaire_version",
    "intent",
    "idempotency_key"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
