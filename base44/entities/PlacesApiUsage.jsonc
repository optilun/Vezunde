{
  "name": "PlacesApiUsage",
  "type": "object",
  "properties": {
    "bucket_key": {
      "type": "string"
    },
    "count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "bucket_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}