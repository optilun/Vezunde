{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "medic_oftalmolog",
        "optometrist",
        "optician"
      ]
    },
    "professional_type": {
      "type": "string",
      "enum": [
        "ophthalmologist",
        "optometrist",
        "optician"
      ]
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bio": {
      "type": "string"
    },
    "professional_bio": {
      "type": "string"
    },
    "public_display_name": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "public_website_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "public_phone": {
      "type": "string"
    },
    "public_email": {
      "type": "string"
    },
    "accepts_independent_requests": {
      "type": "boolean",
      "default": false
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending_review",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by_user_id": {
      "type": "string"
    },
    "public_visibility_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected",
        "needs_more_info",
        "archived"
      ],
      "default": "draft"
    },
    "profile_completeness": {
      "type": "number",
      "default": 0
    },
    "profile_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_public": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}