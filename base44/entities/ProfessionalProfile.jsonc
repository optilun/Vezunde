{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "medic_oftalmolog",
        "optometrist",
        "optician"
      ]
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bio": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "full_name"
  ]
}