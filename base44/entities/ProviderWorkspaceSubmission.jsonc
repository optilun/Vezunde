{
  "name": "ProviderWorkspaceSubmission",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "enum": [
        "public_profile",
        "location_details",
        "services",
        "team",
        "media",
        "article"
      ]
    },
    "item_key": {
      "type": "string"
    },
    "payload_json": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "needs_more_info",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "default": "draft"
    },
    "submitted_by_user_id": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by_user_id": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_note": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "location_id",
    "section",
    "submitted_by_user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}