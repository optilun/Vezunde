{
  "name": "LocationSpecialization",
  "type": "object",
  "properties": {
    "location_id": {
      "type": "string"
    },
    "specialization_key": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "location_id",
    "specialization_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}