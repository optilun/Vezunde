{
  "name": "ProviderMediaAsset",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "submission_id": {
      "type": "string"
    },
    "uploaded_by_user_id": {
      "type": "string"
    },
    "storage_reference": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "logo",
        "cover",
        "gallery",
        "team_photo",
        "location_photo"
      ]
    },
    "caption": {
      "type": "string"
    },
    "alt_text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "default": "draft"
    },
    "cleanup_status": {
      "type": "string",
      "enum": [
        "pending_attachment",
        "active",
        "pending_cleanup",
        "cleaned"
      ],
      "default": "active"
    },
    "cleanup_reason": {
      "type": "string"
    },
    "cleanup_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "cleanup_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "reviewed_by_user_id": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admin_note": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "location_id",
    "uploaded_by_user_id",
    "storage_reference",
    "media_type",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
