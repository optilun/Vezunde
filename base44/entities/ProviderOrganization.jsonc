{
  "name": "ProviderOrganization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "organization_type": {
      "type": "string",
      "enum": [
        "independent_optical_store",
        "optical_chain",
        "ophthalmology_clinic",
        "ophthalmology_office",
        "independent_ophthalmologist",
        "independent_optometrist",
        "independent_optician",
        "optical_laboratory_b2c",
        "optical_laboratory_b2b",
        "future_b2b_distributor"
      ]
    },
    "directory_external_key": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "directory_source_version": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "organization_type_code": {
      "type": "string",
      "enum": [
        "independent_optical_store",
        "optical_chain",
        "ophthalmology_clinic",
        "ophthalmology_office",
        "healthcare_network",
        "multi_specialty_healthcare_provider",
        "public_healthcare_institution",
        "independent_professional",
        "optical_laboratory",
        "b2b_distributor",
        "other"
      ]
    },
    "control_status": {
      "type": "string",
      "enum": [
        "directory",
        "claimed",
        "verified",
        "suspended"
      ],
      "default": "directory"
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "hidden",
        "archived"
      ],
      "default": "draft"
    },
    "data_quality_status": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "conflict"
      ],
      "default": "low",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_checked_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "public_display_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "logo_review_status": {
      "type": "string",
      "enum": [
        "none",
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "none"
    },
    "logo_review_submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "logo_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "logo_review_note": {
      "type": "string"
    },
    "logo_review_location_id": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "public_description": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "public_phone": {
      "type": "string"
    },
    "public_email": {
      "type": "string"
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "profile_completeness": {
      "type": "number",
      "default": 0
    },
    "public_visibility_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected",
        "needs_more_info",
        "archived"
      ],
      "default": "draft"
    },
    "profile_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "activa",
        "inactiva"
      ],
      "default": "activa"
    }
  },
  "required": [
    "name",
    "organization_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
