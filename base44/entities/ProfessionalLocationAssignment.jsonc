{
  "name": "ProfessionalLocationAssignment",
  "type": "object",
  "properties": {
    "professional_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "professional_type": {
      "type": "string",
      "enum": [
        "ophthalmologist",
        "optometrist",
        "optician"
      ]
    },
    "source_invitation_id": {
      "type": "string"
    },
    "confirmed_by_professional_at": {
      "type": "string",
      "format": "date-time"
    },
    "active_status": {
      "type": "string",
      "enum": [
        "activ",
        "inactiv"
      ],
      "default": "activ"
    },
    "public_status": {
      "type": "string",
      "enum": [
        "public",
        "privat"
      ],
      "default": "privat"
    },
    "visibility_consent_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "pending",
        "accepted",
        "declined",
        "revoked"
      ],
      "default": "not_requested"
    },
    "visibility_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "visibility_requested_by_user_id": {
      "type": "string"
    },
    "visibility_decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "visibility_decided_by_user_id": {
      "type": "string"
    },
    "visibility_revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "association_origin": {
      "type": "string",
      "enum": [
        "invitation",
        "professional_request",
        "owner_self"
      ],
      "description": "Cum a pornit asocierea: invitatia organizatiei, cererea specialistului (\u201eLucrez aici\u201d) sau ownerul care se afiseaza singur ca specialist. Lipsa = invitatie (randuri vechi)."
    },
    "association_request_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined",
        "withdrawn"
      ],
      "description": "Doar pentru cererile trimise de specialist: decizia organizatiei. Cat timp e pending, asocierea ramane inactiva si privata."
    },
    "association_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "association_decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "association_decided_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "professional_id",
    "location_id",
    "professional_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}