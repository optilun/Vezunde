{
  "name": "OutreachContact",
  "type": "object",
  "properties": {
    "contact_kind": {
      "type": "string",
      "enum": [
        "directory",
        "provider_account"
      ],
      "default": "directory",
      "description": "De unde vine contactul: directory = adresa publica a unei locatii/organizatii din director; provider_account = utilizator cu cont de furnizor pe VIASEE (membru activ al unei organizatii). Campaniile aleg sursele in audience_sources."
    },
    "user_id": {
      "type": "string",
      "description": "Doar pentru provider_account: utilizatorul VIASEE."
    },
    "account_active": {
      "type": "boolean",
      "description": "Doar pentru provider_account: false cand utilizatorul nu mai are niciun acces activ la o organizatie. Contul inactiv nu mai primeste campanii."
    },
    "unsubscribed_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categoriile din care s-a dezabonat (marketing / announcement). Dezabonarea totala ramane email_status = unsubscribed."
    },
    "location_id": {
      "type": "string",
      "description": "ProviderLocation asociata, daca a fost materializat din director. Pentru o adresa de organizatie: prima locatie alfabetic dintre cele care folosesc adresa."
    },
    "organization_id": {
      "type": "string",
      "description": "ProviderOrganization asociata, daca exista"
    },
    "company_name": {
      "type": "string",
      "description": "Numele firmei/locatiei. Pentru o adresa de organizatie: numele organizatiei."
    },
    "email": {
      "type": "string",
      "description": "Adresa de email originala"
    },
    "contact_name": {
      "type": "string",
      "description": "Numele persoanei de contact, daca e cunoscut"
    },
    "city": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "description": "provider_type copiat din ProviderLocation la materializare. Segmentarea campaniilor filtreaza pe acest camp."
    },
    "profile_control_status": {
      "type": "string",
      "description": "directory/claimed/verified/suspended, copiat din locatie. Permite campanii doar catre profilele nerevendicate."
    },
    "organization_location_count": {
      "type": "number",
      "description": "Cate locatii are organizatia din care face parte contactul. Sta la baza tag-urilor retea:locatie-unica / retea:grup-mic / retea:lant."
    },
    "email_scope": {
      "type": "string",
      "enum": [
        "location",
        "organization"
      ],
      "default": "location",
      "description": "A cui e adresa: location = o singura locatie din director o foloseste; organization = aceeasi adresa e folosita de mai multe locatii (de obicei sediul unui lant). Se calculeaza la sincronizare; campaniile pot tinti separat cele doua tipuri."
    },
    "shared_location_count": {
      "type": "number",
      "description": "Cate locatii publice din director folosesc aceasta adresa (1 pentru o adresa de locatie). Alimenteaza campul de sablon [LOCATII]."
    },
    "shared_city_count": {
      "type": "number",
      "description": "In cate orase sunt locatiile care folosesc aceasta adresa. Alimenteaza campul de sablon [ORASE]."
    },
    "email_domain_status": {
      "type": "string",
      "enum": [
        "ok",
        "domain_missing",
        "no_mail_server",
        "dns_error"
      ],
      "description": "Rezultatul verificarii DNS (MX) a domeniului adresei, la sincronizare si inainte de fiecare trimitere. domain_missing / no_mail_server = adresa nu poate primi email: exclusa la aprobare si sarita la trimitere. dns_error = serverele DNS ale domeniului raspund cu eroare (poate fi trecator). Se recalculeaza la fiecare sincronizare, deci o adresa reparata redevine eligibila."
    },
    "email_domain_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cand s-a schimbat ultima data email_domain_status"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "replied",
        "interested",
        "not_interested",
        "unsubscribed",
        "converted",
        "bounced",
        "invalid",
        "complained"
      ],
      "default": "new"
    },
    "normalized_email": {
      "type": "string",
      "description": "Email normalizat (lowercase, trim) folosit pentru deduplicare si trimitere"
    },
    "email_status": {
      "type": "string",
      "enum": [
        "active",
        "unsubscribed",
        "bounced",
        "invalid",
        "complained"
      ],
      "default": "active"
    },
    "source": {
      "type": "string",
      "description": "public_directory, provider_account, manual, import, referral, partner, event, other"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Etichete pentru segmentare. Cele cu prefix tip:/retea:/profil:/adresa: sunt puse automat la sincronizarea din director si reimprospatate la fiecare sincronizare; restul sunt ale adminului si nu se ating."
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_status_change_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "unsubscribe_reason": {
      "type": "string"
    },
    "consent_audit": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Istoric minimal de audit: {at, source, action, reason}"
    },
    "lawful_basis": {
      "type": "string",
      "enum": [
        "legitimate_interest",
        "consent",
        "contract"
      ],
      "default": "legitimate_interest",
      "description": "Temeiul legal: legitimate_interest pentru adrese publice de afaceri din director, contract pentru utilizatorii cu cont de furnizor, consent pentru consimtamant explicit"
    },
    "source_url": {
      "type": "string",
      "description": "Sursa publica de unde provine adresa (preluata din ProviderLocation.source_url la materializare)"
    },
    "collection_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data colectarii adresei (preluata din ProviderLocation.collected_at la materializare)"
    },
    "source_type": {
      "type": "string",
      "description": "public_directory, provider_account, manual, import, referral, partner, event, other"
    },
    "lia_notes": {
      "type": "string",
      "description": "Note privind evaluarea de interes legitim (Legitimate Interest Assessment) pentru aceasta trimitere"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}