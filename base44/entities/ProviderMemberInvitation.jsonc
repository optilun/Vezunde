{
  "name": "ProviderMemberInvitation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "invited_location_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invited_email_normalized": {
      "type": "string"
    },
    "proposed_role": {
      "type": "string",
      "enum": [
        "organization_owner",
        "organization_admin",
        "location_manager",
        "location_staff"
      ]
    },
    "organization_wide_access": {
      "type": "boolean",
      "default": false
    },
    "invited_by_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "accepted",
        "expired",
        "revoked"
      ],
      "default": "pending"
    },
    "secure_token_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "manual_required",
        "failed"
      ],
      "default": "pending"
    },
    "delivery_provider": {
      "type": "string",
      "enum": [
        "base44",
        "resend",
        "manual"
      ]
    },
    "delivery_message_id": {
      "type": "string"
    },
    "last_delivery_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_error": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "accepted_by_user_id": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by_user_id": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "invited_location_ids",
    "invited_email_normalized",
    "proposed_role",
    "invited_by_user_id",
    "status",
    "secure_token_hash",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
