{
  "name": "ProviderMemberInvitation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "invited_location_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invited_email_normalized": {
      "type": "string"
    },
    "proposed_role": {
      "type": "string",
      "enum": [
        "organization_owner",
        "location_manager",
        "location_staff"
      ]
    },
    "invited_by_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "accepted",
        "expired",
        "revoked"
      ],
      "default": "pending"
    },
    "secure_token_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_by_user_id": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by_user_id": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "invited_location_ids",
    "invited_email_normalized",
    "proposed_role",
    "invited_by_user_id",
    "status",
    "secure_token_hash",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}