{
  "name": "PatientRequestContact",
  "properties": {
    "access_token_hash": {
      "type": "string"
    },
    "account_access_grants": {
      "description": "Accese cerute din contul care a trimis cererea (doar hash-ul tokenului, valabil 30 de zile).",
      "items": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "token_hash": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_email_verification_attempts": {
      "default": 0,
      "type": "number"
    },
    "contact_email_verification_delivery_status": {
      "default": "not_sent",
      "enum": [
        "not_sent",
        "pending",
        "sent",
        "failed",
        "verified"
      ],
      "type": "string"
    },
    "contact_email_verification_error": {
      "type": "string"
    },
    "contact_email_verification_expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "contact_email_verification_hash": {
      "type": "string"
    },
    "contact_email_verification_provider": {
      "type": "string"
    },
    "contact_email_verification_sent_at": {
      "format": "date-time",
      "type": "string"
    },
    "contact_email_verified": {
      "default": false,
      "type": "boolean"
    },
    "contact_email_verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_preference": {
      "default": "email",
      "enum": [
        "email",
        "phone",
        "either"
      ],
      "type": "string"
    },
    "email_verification_lock_at": {
      "format": "date-time",
      "type": "string"
    },
    "email_verification_lock_token": {
      "type": "string"
    },
    "processing_consent": {
      "default": false,
      "type": "boolean"
    },
    "processing_consent_at": {
      "format": "date-time",
      "type": "string"
    },
    "processing_consent_version": {
      "type": "string"
    },
    "provider_contact_sharing_consent": {
      "default": false,
      "type": "boolean"
    },
    "provider_contact_sharing_consent_at": {
      "format": "date-time",
      "type": "string"
    },
    "provider_request_distribution_consent": {
      "default": false,
      "type": "boolean"
    },
    "provider_request_distribution_consent_at": {
      "format": "date-time",
      "type": "string"
    },
    "provider_request_distribution_consent_version": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "requester_user_id": {
      "type": "string"
    },
    "retention_policy_key": {
      "type": "string"
    },
    "retention_until": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "anonymized",
        "deleted"
      ],
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "contact_name",
    "processing_consent",
    "processing_consent_version"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}