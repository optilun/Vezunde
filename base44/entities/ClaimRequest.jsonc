{
  "name": "ClaimRequest",
  "type": "object",
  "properties": {
    "location_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_asteptare",
        "aprobata",
        "respinsa"
      ],
      "default": "in_asteptare"
    }
  },
  "required": [
    "business_name",
    "contact_name",
    "email"
  ]
}