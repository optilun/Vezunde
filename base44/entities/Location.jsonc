{
  "name": "Location",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "optica_medicala",
        "clinica_oftalmologica",
        "cabinet_oftalmologic",
        "cabinet_optometric",
        "laborator_optic"
      ]
    },
    "city": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opening_hours": {
      "type": "string"
    },
    "availability_note": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_claimed": {
      "type": "boolean",
      "default": false
    },
    "response_quality_score": {
      "type": "number",
      "default": 0
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "provider_type",
    "city"
  ]
}