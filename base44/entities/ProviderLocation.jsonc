{
  "name": "ProviderLocation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "optica_medicala",
        "clinica_oftalmologica",
        "cabinet_oftalmologic",
        "cabinet_optometric",
        "laborator_optic",
        "optometrist_independent",
        "medic_oftalmolog_independent"
      ]
    },
    "provider_profile_type": {
      "type": "string",
      "enum": [
        "independent_optical_store",
        "optical_chain",
        "ophthalmology_clinic",
        "ophthalmology_office",
        "independent_ophthalmologist",
        "independent_optometrist",
        "independent_optician",
        "optical_laboratory_b2c",
        "optical_laboratory_b2b",
        "future_b2b_distributor"
      ]
    },
    "city": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "locality_siruta_code": {
      "type": "string"
    },
    "locality_name": {
      "type": "string"
    },
    "county_code": {
      "type": "string"
    },
    "county_name": {
      "type": "string"
    },
    "uat_code": {
      "type": "string"
    },
    "uat_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "place_id": {
      "type": "string"
    },
    "phone_public": {
      "type": "string"
    },
    "public_email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "opening_hours": {
      "type": "string"
    },
    "saturday_hours": {
      "type": "string"
    },
    "public_display_name": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_description": {
      "type": "string"
    },
    "public_phone": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "opening_hours_json": {
      "type": "string"
    },
    "request_intake_status": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "paused"
      ],
      "default": "inactive"
    },
    "public_visibility_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected",
        "needs_more_info",
        "archived"
      ],
      "default": "draft"
    },
    "accepts_patients_directly": {
      "type": "boolean",
      "default": false
    },
    "profile_completeness": {
      "type": "number",
      "default": 0
    },
    "profile_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_verificare",
        "publicata",
        "suspendata"
      ],
      "default": "draft"
    },
    "profile_control_status": {
      "type": "string",
      "enum": [
        "directory",
        "claimed",
        "verified",
        "suspended"
      ],
      "default": "directory"
    },
    "claim_verification_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "profile_control_status_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_control_status_reason": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "migration_review_required": {
      "type": "boolean",
      "default": false,
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_url": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_name": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_type": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_checked_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "collected_by": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "data_confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_notes": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
