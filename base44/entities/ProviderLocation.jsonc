    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
