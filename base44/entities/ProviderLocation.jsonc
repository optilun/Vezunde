{
  "name": "ProviderLocation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "optica_medicala",
        "clinica_oftalmologica",
        "cabinet_oftalmologic",
        "cabinet_optometric",
        "laborator_optic",
        "optometrist_independent",
        "medic_oftalmolog_independent"
      ]
    },
    "city": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "place_id": {
      "type": "string"
    },
    "phone_public": {
      "type": "string"
    },
    "public_email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "opening_hours": {
      "type": "string"
    },
    "saturday_hours": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_verificare",
        "publicata",
        "suspendata"
      ],
      "default": "draft"
    },
    "profile_control_status": {
      "type": "string",
      "enum": [
        "directory",
        "claimed",
        "verified",
        "suspended"
      ],
      "default": "directory"
    },
    "claim_verification_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none"
    },
    "profile_control_status_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_control_status_reason": {
      "type": "string"
    },
    "migration_review_required": {
      "type": "boolean",
      "default": false
    },
    "source_url": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "collected_by": {
      "type": "string"
    },
    "data_confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "source_notes": {
      "type": "string"
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "unclaimed",
        "in_verification",
        "verified",
        "suspended"
      ],
      "default": "unclaimed"
    },
    "pending_changes": {
      "type": "string"
    },
    "active_status": {
      "type": "string",
      "enum": [
        "activa",
        "inactiva"
      ],
      "default": "activa"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "data_source": {
      "type": "string",
      "enum": [
        "manual",
        "claim",
        "public_source",
        "google_place_reference"
      ]
    },
    "last_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "astazi",
        "urmatoarele_zile",
        "saptamana_aceasta",
        "doar_programare",
        "necunoscuta"
      ],
      "default": "necunoscuta"
    },
    "availability_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "provider_type",
    "city"
  ]
}