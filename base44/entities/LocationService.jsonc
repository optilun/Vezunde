{
  "name": "LocationService",
  "type": "object",
  "properties": {
    "location_id": {
      "type": "string"
    },
    "service_key": {
      "type": "string"
    },
    "accepts_requests": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
