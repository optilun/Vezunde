{
  "name": "OutreachCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Numele campaniei"
    },
    "category": {
      "type": "string",
      "enum": [
        "marketing",
        "announcement"
      ],
      "default": "marketing",
      "description": "marketing = prezentari si invitatii; announcement = anunturi despre VIASEE. Decide ce sabloane se pot alege, textul din subsol si din ce lista se dezaboneaza destinatarul."
    },
    "campaign_type": {
      "type": "string",
      "enum": [
        "claim_notice",
        "marketing"
      ],
      "default": "marketing",
      "description": "Camp vechi, pastrat pentru compatibilitate. Categoria reala e in 'category'."
    },
    "template_id": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "description": "Subiectul emailului"
    },
    "body_html": {
      "type": "string",
      "description": "Continutul emailului"
    },
    "cta_label": {
      "type": "string",
      "description": "Textul butonului principal din email (ex. 'Revendica-ti profilul'). Gol = emailul nu are buton."
    },
    "cta_url": {
      "type": "string",
      "description": "Linkul butonului principal. Doar http/https; orice altceva e ignorat la randare."
    },
    "show_listing_preview": {
      "type": "boolean",
      "default": true,
      "description": "Afiseaza in email fisa destinatarului din director (numele, tipul si orasul lui reale). Se dezactiveaza pentru campaniile care nu vorbesc despre profilul din director."
    },
    "from_name": {
      "type": "string",
      "default": "VIASEE"
    },
    "from_email": {
      "type": "string"
    },
    "reply_to_email": {
      "type": "string"
    },
    "audience_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "De unde se aleg destinatarii: directory (contactele din director) si/sau provider_account (furnizorii cu cont). Gol = directory."
    },
    "audience_mode": {
      "type": "string",
      "enum": [
        "filters",
        "manual"
      ],
      "default": "filters",
      "description": "filters = toti cei care se potrivesc filtrelor (minus excluderile manuale, plus adaugarile manuale); manual = doar contactele alese unul cate unul (included_contact_ids)."
    },
    "included_contact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Contacte adaugate manual, chiar daca nu se potrivesc filtrelor"
    },
    "excluded_contact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Contacte scoase manual (debifate) din lista rezultata din filtre"
    },
    "target_counties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Judete tinta (county_name), gol = toate"
    },
    "target_provider_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "provider_type tinta, gol = toate"
    },
    "target_profile_control_status": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "directory/claimed/verified/suspended, gol = toate"
    },
    "target_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag-uri OutreachContact tinta, gol = toate"
    },
    "target_email_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "location/organization (vezi OutreachContact.email_scope), gol = ambele. Permite o campanie separata, cu alt text, pentru adresele comune mai multor locatii."
    },
    "daily_send_limit": {
      "type": "number",
      "default": 50,
      "description": "Cate emailuri trimite campania pe zi (ora Romaniei), intre 10 si 2000. Cu daily_send_ramp activ e limita din prima zi de trimitere."
    },
    "daily_send_ramp": {
      "type": "boolean",
      "default": true,
      "description": "Dubleaza limita in fiecare zi in care campania a trimis (50, 100, 200...), ca domeniul de trimitere sa-si construiasca reputatia treptat."
    },
    "next_send_after": {
      "type": "string",
      "format": "date-time",
      "description": "Limita zilei a fost atinsa: trimiterea se reia dupa acest moment (a doua zi la 09:00, ora Romaniei). Gol = nicio asteptare."
    },
    "pause_reason": {
      "type": "string",
      "description": "De ce e campania pe pauza: admin, bounce_rate (prea multe emailuri respinse) sau complaints (reclamatie de spam). Ultimele doua sunt puse automat."
    },
    "auto_paused_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cand a fost oprita automat campania (bounce_rate / complaints)"
    },
    "health_baseline": {
      "type": "object",
      "description": "{sent, bounced, complained, at}: contoarele in momentul in care adminul a reluat o campanie oprita automat. Oprirea automata se calculeaza doar pe ce s-a trimis dupa acest moment."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "sending",
        "sent",
        "paused",
        "failed",
        "cancelled"
      ],
      "default": "draft"
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "opened_count": {
      "type": "number",
      "default": 0
    },
    "clicked_count": {
      "type": "number",
      "default": 0
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "skipped_count": {
      "type": "number",
      "default": 0
    },
    "bounced_count": {
      "type": "number",
      "default": 0
    },
    "delivered_count": {
      "type": "number",
      "default": 0
    },
    "complained_count": {
      "type": "number",
      "default": 0
    },
    "recipient_count": {
      "type": "number",
      "default": 0,
      "description": "Numarul destinatarilor eligibili calculat la crearea/aprobarea campaniei"
    },
    "recipient_contact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista inghetata de OutreachContact.id la momentul aprobarii; cursorul de trimitere (current_cursor) indexeaza exact in aceasta lista. Fara acest camp, trimiterea nu are destinatari si campania s-ar marca 'sent' fara sa fi trimis nimic."
    },
    "current_cursor": {
      "type": "number",
      "default": 0,
      "description": "Pozitia in lista de destinatari pana unde s-a trimis (pentru trimitere pe loturi via cron)"
    },
    "consecutive_send_failures": {
      "type": "number",
      "default": 0,
      "description": "Numarul de loturi consecutive esuate din cauze tranzitorii (rate limit, 5xx). Se reseteaza la primul lot reusit; peste plafon campania trece in 'failed' in loc sa reincerce la infinit."
    },
    "execution_lock_token": {
      "type": "string"
    },
    "execution_lock_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_token_hash": {
      "type": "string",
      "description": "Hash-ul confirmarii tastate de admin inainte de trimitere reala"
    },
    "approved_by_user_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "resend_batch_id": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "failure_message": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "subject"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}